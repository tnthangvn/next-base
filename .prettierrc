{
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": false,
  "printWidth": 150,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.{css,scss,less,sass,postcss}"],
      "options": {
        "tabWidth": 2,
        "plugins": ["prettier-plugin-tailwindcss"]
      }
    },
    {
      "files": ["*.{json,jsonc}"],
      "options": {
        "tabWidth": 2,
        "quoteProps": "preserve",
        "parser": "json",
        "plugins": ["prettier-plugin-sort-json"]
      }
    }
  ]
}
